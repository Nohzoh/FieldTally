<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (#154) metadata. Floored at one counter row rather
     than the launcher's 1x1 minimum, a cramped widget would ellipsize the
     one line it exists to show, and not two (#187): minHeight/targetCellHeight
     set the smallest size a placed widget can ever be resized to, never
     just its initial one, and resizeMode allows growing it back up to
     however many rows FieldTallyWidgetProvider.rowsThatFit will show
     (currently up to four). A one-counter pin (#181, from
     CounterDetailScreen) has nowhere to shrink to otherwise; a
     multi-counter one costs a single upward resize instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/field_tally_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="io.nohzoh.fieldtally.WidgetConfigureActivity" />
