#!/usr/bin/env bash
# Project-scoped `gh` wrapper for FieldTally.
#
# Loads the repo's dedicated fine-grained PAT from .secrets/gh_token (never
# committed) into GH_TOKEN, then delegates to the real `gh`. GH_TOKEN takes
# precedence over the credential stored in the keyring, so the personal account
# identity is never used here — and we NEVER run `gh auth login`, which would
# switch the active account globally.
#
# Usage:  ./scripts/gh repo view
#         ./scripts/gh auth status
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
token_file="$repo_root/.secrets/gh_token"

if [[ ! -f "$token_file" ]]; then
  echo "Token not found: $token_file" >&2
  echo "Create a fine-grained PAT for Nohzoh/FieldTally and write it there." >&2
  exit 1
fi

# Tolerate a file written with a trailing newline or stray whitespace.
GH_TOKEN="$(tr -d '[:space:]' < "$token_file")"
if [[ -z "$GH_TOKEN" ]]; then
  echo "Empty token: $token_file" >&2
  exit 1
fi
export GH_TOKEN

# Neutralise the other auth sources so a rejected token cannot silently fall
# back to the personal account.
unset GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN

exec gh "$@"
