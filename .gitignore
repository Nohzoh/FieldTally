# --- Project secrets (NEVER committed) ---
# Fine-grained GitHub PAT scoped to FieldTally, loaded into GH_TOKEN by
# scripts/gh — see CONTRIBUTING.md.
.secrets/
*.token
.env
.env.*

# --- OS and editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp

# --- Flutter / Dart ---
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/coverage/
app/.packages

# --- Android ---
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/app/*.jks
app/android/app/*.keystore
app/android/.idea/

# --- iOS (not a v1 target, but the door stays open) ---
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh

# --- GitHub Pages site (Jekyll) ---
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
